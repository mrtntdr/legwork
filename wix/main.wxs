<?xml version='1.0' encoding='windows-1252'?>

<!--
  WiX installer definition for Legwork. Generated by `cargo wix init` and then
  adapted for a GUI app: no PATH entry, a Start Menu shortcut, and the app icon
  shown in Add/Remove Programs. Built with `cargo wix` (see scripts/windows).
-->

<!--
  These pre-processor If-Else blocks pick the install location for 32-bit vs
  64-bit installers. Required by `cargo wix`; do not remove.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Legwork'
        UpgradeCode='7B89C8FD-ED69-4791-B471-A59992F2FB28'
        Manufacturer='Legwork'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Legwork — orienteering analysis'
            Manufacturer='Legwork'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Legwork Installation'/>

        <!-- Icon shown in the Add/Remove Programs (Apps & features) listing. -->
        <Icon Id='Product.ico' SourceFile='app_icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='Product.ico'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Legwork'>
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='legwork.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\legwork.exe'
                            KeyPath='yes'>
                            <!-- Advertised Start Menu shortcut to the app. -->
                            <Shortcut Id='StartMenuShortcut'
                                Directory='ProgramMenuDir'
                                Name='Legwork'
                                Description='Orienteering analysis app'
                                WorkingDirectory='APPLICATIONFOLDER'
                                Icon='Product.ico'
                                Advertise='yes'/>
                        </File>
                    </Component>
                </Directory>
            </Directory>

            <!-- Start Menu folder holding the shortcut, cleaned up on uninstall. -->
            <Directory Id='ProgramMenuFolder' Name='Programs'>
                <Directory Id='ProgramMenuDir' Name='Legwork'>
                    <Component Id='ProgramMenuDirComp' Guid='*'>
                        <RemoveFolder Id='RemoveProgramMenuDir' On='uninstall'/>
                        <RegistryValue Root='HKCU'
                            Key='Software\[Manufacturer]\[ProductName]'
                            Type='string' Value='' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs Legwork.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ProgramMenuDirComp'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
